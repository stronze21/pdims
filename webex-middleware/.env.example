# Server
PORT=3000
API_KEY=your-secure-api-key-here

# Webex OAuth (Service Account)
WEBEX_CLIENT_ID=your-webex-integration-client-id
WEBEX_CLIENT_SECRET=your-webex-integration-client-secret
WEBEX_REFRESH_TOKEN=your-initial-refresh-token

# Webex Guest Issuer
WEBEX_GUEST_ISSUER_ID=your-guest-issuer-id
WEBEX_GUEST_SHARED_SECRET=your-guest-issuer-shared-secret
